# PostgreSQL — local or Railway Postgres plugin
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/escalation?schema=public"

# API (Railway sets PORT automatically; API_PORT is for local only)
PORT=4000
API_PORT=4000
HOST=0.0.0.0
JWT_SECRET="change-me-in-production-escalation-portal-secret"
CORS_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
