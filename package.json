{
  "name": "escalation-portal",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @escalation/web dev",
    "dev:api": "pnpm --filter @escalation/api dev",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @escalation/db generate",
    "db:push": "pnpm --filter @escalation/db push",
    "db:seed": "pnpm --filter @escalation/db seed",
    "db:studio": "pnpm --filter @escalation/db studio"
  },
  "engines": {
    "node": ">=20"
  }
}
